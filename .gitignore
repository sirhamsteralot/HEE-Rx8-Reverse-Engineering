# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
__pycache__/
*.pyc
venv/
.env

# Local tooling / scratch
*.log
# pipeline export logs under data/labels are tracked artifacts
!data/labels/**/*.log
scratch/

# Binary dumps (*.bin, *.ori, *.dump, *.bak) are handled by .gitattributes via Git LFS.
# Very large captures may instead be kept out of the repo with only their SHA-256
# recorded in binaries/manifest.csv.

# input/ is a raw intake drop zone (bins, prior efforts, cloned repos, sources).
# Its contents are never committed; only input/README.md is tracked.
input/*
!input/README.md
.venv/
