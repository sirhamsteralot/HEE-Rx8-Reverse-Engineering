# Line endings: text files are stored with LF and a checkout converts them to the
# host's convention (core.autocrlf=true on Windows). Without this, a clone that has
# neither attribute nor `core.autocrlf` set materialises every text file with CRLF,
# `git status` then reports the whole tree as modified, and every regeneration test
# that compares bytes fails on line endings alone. The LFS patterns below override
# `text` for binary blobs.
* text=auto

# Route binary blobs through Git LFS (git-lfs required to clone/checkout these)
*.bin linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.ori linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.dump linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.bak linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.gar linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.zip linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.jar linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.exe linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.dll linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.so linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.pdf linguist-generated=true filter=lfs diff=lfs merge=lfs -text
*.vtlog linguist-generated=true filter=lfs diff=lfs merge=lfs -text
